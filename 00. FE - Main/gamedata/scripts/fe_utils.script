----------------------------------------------------------------------------------------------------
-- Setters
----------------------------------------------------------------------------------------------------

function set_s_cond(obj, val)
	if not failsafe(obj) then return end -- failsafe
	if not val then val = 1 end -- failsafe

	local was_broken = is_broken(obj)
	val = clamp(val, 0, 1)
	item_device.dev_items[obj:id()].s_cond = val
	local now_broken = val <= S_COND_BROKEN

	if now_broken and not was_broken then
		-- device just broke
		obj:set_device_enabled(false)
		play_shutdown_sound()

		if db.actor:item_in_slot(8) and db.actor:item_in_slot(8):id() == obj:id() then
			ui_pda_radio_tab.action_radio_stop()
			ui_pda_radio_tab.action_plyr_stop()
		end
	elseif (not now_broken) and was_broken then
		-- device just got fixed
		obj:set_device_enabled(true)
	end
end

function set_screen_damage(obj, val)
    if not failsafe(obj) then return end -- failsafe

    local damage
    if val == 1 then
        damage = get_screen_damage(obj) + 1
        if damage > 5 then
            set_s_cond(obj, 0) -- screen shattered badly enough to take the whole device out
        end
        damage = clamp(damage, 0, 5)
        utils_obj.play_sound("material\\glass\\glass_fall03hl")
    elseif val == 2 then
        damage = get_screen_damage(obj)
    else
        damage = 0
        news_manager.send_tip(db.actor, game.translate_string("st_pda_screen_fix"), nil, default, 10000)
    end

    if damage == 0 then
        obj:set_shader(1, "pda_screen", "item\\item_pda2\\item_pda_glass", true)
    else
        obj:set_shader(1, "pda_screen", "item\\item_pda2\\item_pda_glass_damage" .. damage, true)
    end
    item_device.dev_items[obj:id()].screen_damage = damage

end

function set_bsod(obj, val)
    if not failsafe(obj) then return end -- failsafe
    if not val then val = false end -- failsafe

    item_device.dev_items[obj:id()].is_bsod = val
end

function set_pda_xml(obj)
    if not failsafe(obj) then return end -- failsafe
    if item_device.dev_items[obj:id()].interface == nil then item_device.dev_items[obj:id()].interface = "pda" end -- fallback to default UI if UI is nil

    local curr_interface = ActorMenu.get_pda_menu():GetPdaXml():gsub("%.xml", "")
    local base_interface = item_device.dev_items[obj:id()].interface

    if curr_interface ~= base_interface then
        ActorMenu.get_pda_menu():SetPdaXml(base_interface .. ".xml")
    end

    if fatal_error_mcm.REBOOT > 0 then
        ActorMenu.get_pda_menu():SetActiveSubdialog("eptReboot")
    end

end

local cache_obj
function set_apps(obj)
    if not failsafe(obj) then return end -- failsafe
    if cache_obj == obj:section() then return end
    cache_obj = obj:section()

    if mac_mcm.PDA_APPS.app_taskboard then mac_mcm.remove_app("app_taskboard") end 
    if mac_mcm.PDA_APPS.app_interactive then mac_mcm.remove_app("app_interactive") end 
    if mac_mcm.PDA_APPS.app_interactive then mac_mcm.remove_app("tab_database") end
    local taskboard = ui_pda_taskboard_tab and ini_sys:r_bool_ex(obj:section(),"tab_taskboard")
    local interactive = pda_inter_gui and ini_sys:r_bool_ex(obj:section(),"tab_interactive")
    local database = ini_sys:r_bool_ex(obj:section(),"tab_database")

    if taskboard == true then
        mac_mcm.add_app("app_taskboard", 
            {name = "pda_btn_taskboard", texture = "app_taskboard", tab = "eptTaskboard", func = ui_pda_taskboard_tab.get_ui}
        )
    end
    if interactive == true then
        mac_mcm.add_app("app_interactive", 
            {name = "pda_btn_interactive", texture = "app_interactive", tab = "eptInteractive", func = pda_inter_gui.start_PDAX}
        ) 
    end

    if database == true then

        local western_factions = {
		    ["isg"] = true,
		    ["killer"] = true,
        }

        if western_factions[get_actor_true_community()] then
            mac_mcm.add_app("app_military_database", 
            {name = "st_database", texture = "nato_database", tab = "eptMilitaryDatabase"}
            ) 
        else
            mac_mcm.add_app("app_military_database", 
            {name = "st_database", texture = "afu_database", tab = "eptMilitaryDatabase"}
            ) 
        end

    end

end

----------------------------------------------------------------------------------------------------
-- Issers\Getters
----------------------------------------------------------------------------------------------------

function get_glitch(obj)

    local radiation_glitch = clamp(get_radiation(obj), 0, 10) * fatal_error_mcm.SETTINGS.other.radiation.glitch_scale
    local damage_glitch = (1 - get_s_cond(obj)) * 0.5
    local screen_damage_glitch = get_screen_damage(obj) * 0.1
    local overclock_glitch = is_overclocked(obj) and 0.15 or 0 
    local surge_psi_glitch = get_surge_psi(obj)
    local electra_glitch = get_electra(obj)
    local passive_glitch = fatal_error_mcm.SETTINGS.other.passive_glitch + (LEVEL_PASSIVE_GLITCH[level.name()] and LEVEL_PASSIVE_GLITCH[level.name()] * fatal_error_mcm.SETTINGS.locs.loc_glitch_scale or 0)
    local glitch_factor = obj:has_upgrade("up_fourta_pda") and ini_sys:r_float_ex(obj:section(),"glitch_factor") - 0.90 or ini_sys:r_float_ex(obj:section(),"glitch_factor") or 1
    local final_glitch = (radiation_glitch + damage_glitch + screen_damage_glitch + overclock_glitch + surge_psi_glitch + electra_glitch + passive_glitch) * glitch_factor
	
    return final_glitch
end

function is_broken(obj)
	if not failsafe(obj) then return false end -- failsafe
	return get_s_cond(obj) <= S_COND_BROKEN
end

function is_bsod(obj)
	if not failsafe(obj) then return false end -- failsafe
	return item_device.dev_items[obj:id()].is_bsod
end

function is_overclocked(obj)
	if not failsafe(obj) then return false end -- failsafe
	return item_device.dev_items[obj:id()].is_overclocked
end

function get_s_cond(obj)
    if not failsafe(obj) then return 1 end -- failsafe
    return item_device.dev_items[obj:id()].s_cond or 1
end

function get_screen_damage(obj)
    if not failsafe(obj) then return 0 end -- failsafe
    return item_device.dev_items[obj:id()].screen_damage or 0
end

function get_device_tier(obj)
    if not failsafe(obj) then return 5 end -- failsafe
    if ini_sys:r_float_ex(obj:section(),"tier") <= 5 then
        return ini_sys:r_float_ex(obj:section(),"tier")
    else
        return 5
    end
end

function get_surge_psi(obj)
    if not failsafe(obj) then return 0 end -- failsafe
    if obj:has_upgrade("up_firste_pda") then return 0 end
    if ini_sys:r_bool_ex(obj:section(),"can_break") == false then return 0 end
    
    local surge_psi = 0
	if GetEvent("surge", "state") then
		local surge_time = GetEvent("surge", "time") or 0
		surge_psi = (surge_time > 168) and normalize(surge_time, 220, 168) or normalize(surge_time, 20, 168)
		surge_psi = clamp(surge_psi,0,1)

	elseif GetEvent("psi_storm", "state") then
		if GetEvent("psi_storm", "vortex") then
			surge_psi = 0.3 + (1 - 0.3) * math.random()
		else
			surge_psi = 0.1 + (0.3 - 0.1) * math.random()
		end
	end
	return surge_psi
end

function get_electra(obj)
    if not failsafe(obj) then return 0 end -- failsafe
    if obj:has_upgrade("up_firstc_pda") then return 0 end
    if ini_sys:r_bool_ex(obj:section(),"can_break") == false then return 0 end
	return fatal_error_mcm.ELECTRA_GLITCH_VALUE
end

function get_radiation(obj)
    if not failsafe(obj) then return 0 end -- failsafe
    if obj:has_upgrade("up_firsta_pda") then return 0 end
    if ini_sys:r_bool_ex(obj:section(),"can_break") == false then return 0 end
	return fatal_error_mcm.RADIATION_AMOUNT
end

----------------------------------------------------------------------------------------------------
-- Utilities
----------------------------------------------------------------------------------------------------

function get_cpu()
    local fs = getFS()
    local flist = fs:file_list_open_ex("$logs$", bit_or(FS.FS_ListFiles, FS.FS_RootOnly), "xray_*.log")
    
    for i = 0, flist:Size() - 1 do
        local filename = flist:GetAt(i):NameFull()
        if filename:sub(-4) == ".log" then
            local path = fs:update_path("$logs$", "") .. filename
            local file = io.open(path, "r")
            if file then
                CPU = file:read("*l")
                file:close()
                
                local cpu_model = CPU:match(": (.-) [@[]")
                local cpu_ghz = CPU:match("@ (%d+%.%d+GHz)")
                local cpu_mhz = CPU:match(", (%d+%.%d+ mhz)")
                
                if cpu_model and cpu_ghz then
                    CPU = cpu_model .. " @ " .. cpu_ghz
                elseif cpu_model and cpu_mhz then
                    local mhz_value = tonumber(cpu_mhz:match("%d+%.%d+"))
                    local ghz_value = math.floor(mhz_value / 100 + 0.5) / 10
                    CPU = cpu_model .. " @ " .. ghz_value .. "GHz"
                else
                    CPU = "ERROR: UNABLE TO DETECT CPU"
                    ffi_message("Fatal Error Addon", game.translate_string("st_fe_error") .. " " .. game.translate_string("st_fe_error_cpu") .. " " .. game.translate_string("st_fe_error_end"), 0x00000030, "cpu_error")
                end
                return
            end
        end
    end
    
    CPU = "ERROR: UNABLE TO DETECT CPU"
    ffi_message("Fatal Error Addon", game.translate_string("st_fe_error") .. " " .. game.translate_string("st_fe_error_cpu") .. " " .. game.translate_string("st_fe_error_end"), 0x00000030, "cpu_error")
end

function generate_random_string(length)
    local chars = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local random_string = ""
    for i = 1, length do
        local random_index = math.random(1, #chars)
        random_string = random_string .. chars:sub(random_index, random_index)
    end
    return random_string
end

function to_roman(val)
    if type(val) ~= "number" or val < 1 or val > 3999 then
        return "Error: number must be from 1 to 3999"
    end
    
    local roman_numerals = {
        {1000, "M"},
        {900, "CM"},
        {500, "D"},
        {400, "CD"},
        {100, "C"},
        {90, "XC"},
        {50, "L"},
        {40, "XL"},
        {10, "X"},
        {9, "IX"},
        {5, "V"},
        {4, "IV"},
        {1, "I"}
    }
    
    local result = ""
    for _, pair in ipairs(roman_numerals) do
        local value, symbol = pair[1], pair[2]
        while val >= value do
            result = result .. symbol
            val = val - value
        end
    end
    
    return result
end

function ffi_message(title, message, type, info)
    printf("!FE: Calling FFI! Title: s%, Message: s%, Type: s%, Info: s%", title, message, type, info)
    if true then return end
    if db.actor:has_info(info) then return end -- show message only once.

    give_info(info)
    local ffi = require("ffi")
	local lib = ffi.load("user32")  -- Windows DLL  
	ffi.cdef[[  
	    int MessageBoxA(void* hWnd, const char* text, const char* caption, int type);  
	]]  
	lib.MessageBoxA(nil, message, title, type)
end

----------------------------------------------------------------------------------------------------
-- Helper functions
----------------------------------------------------------------------------------------------------

function failsafe(obj)
    if not obj or not item_device.dev_items[obj:id()] then return false end
    return true
end

function reboot_call(seconds, obj)
	fatal_error_mcm.REBOOT = seconds * (1 - (get_device_tier(obj) - 1 ) * 0.1)
	fatal_error_mcm.process_pda_call()	
end

function invoke(name, time, action)
	CreateTimeEvent("fe_time_event", name, time, function() action() return true end)
end

function play_shutdown_sound()
	sound_object("device\\shutdown\\shutdown_" .. math.random(1, 13)):play_no_feedback(db.actor, sound_object.s3d, 0, db.actor:position(), 0.15, 1.0)
end

----------------------------------------------------------------------------------------------------
-- Other
----------------------------------------------------------------------------------------------------

function save_state(m_data)
    m_data.security_key = SECURITY_KEY
end

function load_state(m_data)
    SECURITY_KEY = m_data.security_key
end

function on_game_start()
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    RegisterScriptCallback("actor_on_first_update", get_cpu)

    --rfs
    RegisterScriptCallback("save_state", rfs_save_state)
    RegisterScriptCallback("load_state", rfs_load_state)
    RegisterScriptCallback("actor_on_first_update", load_rfs)
    RegisterScriptCallback("actor_on_first_update", check_conditions_rfs)

	if not SECURITY_KEY then
		SECURITY_KEY = generate_random_string(20)
	end

    mac_mcm.add_blocked_tabs({"eptReboot","eptBSOD","eptBroken","eptMonolith","eptMonolithHackers","eptBlocked","eptBios", "eptNPC", "eptMilitaryDatabase"})
    mac_mcm.add_app("app_bios", {name = "BIOS", texture = "settings", tab = "eptBios"})
    exec_console_cmd("g_3d_pda 1")

    if not item_device.dev_items then
        assert(false, game.translate_string("st_fe_item_device"))
    end
    
    if get_aoe_version then return end

    if get_modded_exes_version() < 20250823 then
        assert(false, game.translate_string("st_fe_modded_exes"))
    end

end

local _0x31 = false
local _0x32 = false
local _0x33 = string.char(0)

local _0x34 = script_name()

local function rfs_owned_by_other()
    local m_data = alife_storage_manager.get_state()
    return m_data.rfs_owner ~= nil
        and m_data.rfs_owner ~= _0x34
end

local function rfs_try_claim()
    local m_data = alife_storage_manager.get_state()
    if m_data.rfs_owner ~= nil
        and m_data.rfs_owner ~= _0x34
    then
        printf(string.char(38,32,82,70,83,32,105,115,32,97,108,114,101,97,100,121,32,99,108,97,105,109,101,100,32,98,121,58,32) .. _0x34)
        return false
    end

    m_data.rfs_owner = _0x34
    printf(string.char(38,32,82,70,83,32,99,108,97,105,109,101,100,32,98,121,58,32) .. _0x34)
    return true
end

function check_conditions_rfs()
    if rfs_owned_by_other() then return end
    if level.name() ~= string.char(108,49,48,95,114,101,100,95,102,111,114,101,115,116) then return end
    if db.actor:object(string.char(97,102,95,99,111,109,112,97,115,115)) then return end
    if db.actor:has_info(string.char(114,102,115,95,101,110,100,101,100)) then return end
    if math.random(1, 100) < 98 or _0x31 then return end

    RegisterScriptCallback(string.char(97,99,116,111,114,95,111,110,95,117,112,100,97,116,101),check_player_position_rfs)
end

function start_rfs_things()
    tp_to_random_place(100)
    disable_devices()

    local compass_places = {
        {-120.99035644531,-6.2507266998291,-43.034023284912, 7480, 2772},
        {23.489326477051,-1.1079267263412,-208.6944732666, 78487, 2818},
        {175.96200561523,-2.8659892082214,-6.8937125205994, 116324, 2774},
        {-64.09334564209,1.3276805877686,-111.4214553833, 19582, 2805},
    }
    local compass = compass_places[math.random(1,4)]
    alife_create_item(string.char(97,102,95,99,111,109,112,97,115,115),{vector():set(compass[1],compass[2],compass[3]),compass[4],compass[5]})

    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(115,101,116,95,112,111,119,101,114,95,116,111,95,122,101,114,111), 1, function () set_power_to_zero() return true end)
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(116,105,109,101,95,115,107,105,112), 1, function () xr_effects.set_game_time(nil, nil, {21, 45}) return true end)
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(114,97,110,100,111,109,95,101,118,101,110,116), math.random(240, 540), random_event)
    give_info(string.char(114,102,115,95,115,116,97,114,116,101,100))
end

function check_player_position_rfs()
    if rfs_owned_by_other() then
        _0x31 = false
        UnregisterScriptCallback(string.char(97,99,116,111,114,95,111,110,95,117,112,100,97,116,101), check_player_position_rfs)
        return
    end

    if level.name() ~= string.char(108,49,48,95,114,101,100,95,102,111,114,101,115,116) then
        _0x31 = false
        UnregisterScriptCallback(string.char(97,99,116,111,114,95,111,110,95,117,112,100,97,116,101), check_player_position_rfs)
        return
    end

    if db.actor:has_info(string.char(114,102,115,95,115,116,97,114,116,101,100)) and db.actor:object(string.char(97,102,95,99,111,109,112,97,115,115)) then
        give_info(string.char(114,102,115,95,101,110,100,101,100))
