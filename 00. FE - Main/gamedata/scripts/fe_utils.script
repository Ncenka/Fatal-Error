function disable_devices()
    local available_devices = {}

    local function inventory_iterator(actor, item)
        local section = item:section()
        if IsItem(string.char(100,101,118,105,99,101), section)
            and not section:find(string.char(103,108,111,119,115,116,105,99,107))
        then
            table.insert(available_devices, item)
        end
    end

    db.actor:iterate_inventory(inventory_iterator, db.actor)

    for i = 1, #available_devices do
        available_devices[i]:set_device_enabled(false)
    end
end

base_get_light_flicker = level_environment.get_light_flicker()
function level_environment.get_light_flicker()
	if level.name() == string.char(108,49,48,95,114,101,100,95,102,111,114,101,115,116) and db.actor and db.actor:has_info(string.char(114,102,115,95,115,116,97,114,116,101,100)) and not db.actor:has_info(string.char(114,102,115,95,101,110,100,101,100)) then
		return true
    end
	return base_get_light_flicker
end

function set_power_to_zero()
    local available_devices = {}

    local function inventory_iterator(actor, item)
        local section = item:section()
        if (IsItem(string.char(100,101,118,105,99,101), section) or IsItem(string.char(98,97,116,116,101,114,121), section))
            and not section:find(string.char(103,108,111,119,115,116,105,99,107))
        then
            table.insert(available_devices, item)
        end
    end

    db.actor:iterate_inventory(inventory_iterator, db.actor)

    for i = 1, #available_devices do
        alife_process_item(available_devices[i]:section(), available_devices[i]:id(), {cond = 0})
    end
end

function random_event()

    RemoveTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(114,97,110,100,111,109,95,101,118,101,110,116))
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(114,97,110,100,111,109,95,101,118,101,110,116), math.random(240, 540), random_event)

    local events = {
        triple_tp,
        random_consc_lost,
        meta_bloodsucker,
        play_scary_sound
    }

    local event = events[math.random(1, #events)]
    event()

end

function triple_tp()
    if db.actor:has_info(string.char(114,102,115,95,116,114,105,112,108,101,95,116,112)) then return end
    give_info(string.char(114,102,115,95,116,114,105,112,108,101,95,116,112))
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(116,114,105,112,108,101,95,116,112,95,49), 1, function () tp_to_random_place(5) return true end)
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(116,114,105,112,108,101,95,116,112,95,50), math.random(10, 20), function () tp_to_random_place(5) return true end)
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(116,114,105,112,108,101,95,116,112,95,51), math.random(20, 30), function () tp_to_random_place(5) return true end)
end

function random_consc_lost()

    local snd = sound_object(tp_sounds[math.random(#tp_sounds)])
	snd:play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 2.0, 1.0)

	level.add_pp_effector(string.char(115,117,114,103,101,95,102,97,100,101,46,112,112,101), 1000, false)
    level.add_cam_effector(string.char(99,97,109,101,114,97,95,101,102,102,101,99,116,115,92,115,117,114,103,101,95,48,50,46,97,110,109), 1001, false, string.char(0))
    xr_effects.disable_ui_only(db.actor, nil)
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(108,111,115,116,95,99,111,110,115), 6, function() xr_effects.enable_ui(db.actor, nil) return true end)
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(108,111,115,116,95,99,111,110,115,50), 2.5, function() level.add_cam_effector(string.char(99,97,109,101,114,97,95,101,102,102,101,99,116,115,92,115,117,114,103,101,95,48,49,46,97,110,109), 1002, false, string.char(0)) return true end)
    xr_effects.forward_game_time(nil, nil, {0, math.random(30, 60)})

    local m_data = alife_storage_manager.get_state()
    arszi_psy.save_state(m_data)
    local psy_table = m_data.psy_table
    if psy_table.actor_psy_health > 0.50 then
        psy_table.actor_psy_health = psy_table.actor_psy_health - 0.10
    end

end

function meta_bloodsucker()
    if db.actor:has_info(string.char(114,102,115,95,109,101,116,97,95,98,108,111,111,100,115,117,99,107,101,114)) then return end

    sound_object(string.char(114,102,115,95,115,117,99,107,101,114)):play_no_feedback(db.actor, sound_object.s2d, 0, VEC_ZERO, 2.0, 1.0)
    CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(115,117,99,107,101,114), 16.2, function() 
        level.add_cam_effector(string.char(99,97,109,101,114,97,95,101,102,102,101,99,116,115,92,104,101,97,100,95,115,104,111,116,46,97,110,109),1000,false, string.char(0))
        level.add_pp_effector(string.char(97,109,107,95,115,104,111,111,116,46,112,112,101), 1001, false)
        sound_object(string.char(97,99,116,111,114,92,112,97,105,110,95,52)):play(actor,0,sound_object.s2d)
        if db.actor:active_item() then
            db.actor:drop_item(db.actor:active_item())
        end
        if db.actor.health > 0.5 then
            db.actor.health = db.actor.health - 0.1
        end
        level.press_action(bind_to_dik(key_bindings.kCROUCH))
        level.press_action(bind_to_dik(key_bindings.kACCEL))
        give_info(string.char(114,102,115,95,109,101,116,97,95,98,108,111,111,100,115,117,99,107,101,114))
        return true 
    end)
end

