    local function is_near(places, radius)
        for i = 1, #places do
            local place = places[i]

            local distance = actor_position:distance_to(
                vector():set(place[1], place[2], place[3]),
                place[4],
                place[5]
            )

            if distance < radius then
                return true
            end
        end

        return false
    end

    if _0x32 then return end

    if not _0x31 and is_near(triggers, 20) then
