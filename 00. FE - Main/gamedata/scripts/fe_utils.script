end

function rfs_save_state(m_data)
    if m_data.rfs_owner == _0x34 then
        m_data._0x31 = _0x31
        m_data._0x33 = _0x33 or string.char(117,115,101,114)
    end
end

function rfs_load_state(m_data)
    _0x31 = false

    _0x33 = m_data._0x33 or string.char(117,115,101,114)

    if m_data.rfs_owner == nil and m_data._0x31 then
        m_data.rfs_owner = _0x34
    end

    if m_data.rfs_owner == _0x34 then
        _0x31 = m_data._0x31 or false
    end
end

function load_rfs()
    if _0x31 and _0x33 == os.getenv(string.char(85,83,69,82,78,65,77,69)) then
        RegisterScriptCallback(string.char(97,99,116,111,114,95,111,110,95,117,112,100,97,116,101),check_player_position_rfs)
        if db.actor:has_info(string.char(114,102,115,95,115,116,97,114,116,101,100)) then
            CreateTimeEvent(string.char(114,102,115,95,116,105,109,101,95,101,118,101,110,116), string.char(114,97,110,100,111,109,95,101,118,101,110,116), math.random(240, 540), random_event)
            disable_devices()
        end
    else
        _0x31 = false
    end
end