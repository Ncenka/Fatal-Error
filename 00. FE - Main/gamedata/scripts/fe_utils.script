    if _0x31 and db.actor:has_info(string.char(114,102,115,95,115,116,97,114,116,101,100)) and level.get_time_hours() > 5 and level.get_time_hours() < 20 then
        give_info(string.char(114,102,115,95,101,110,100,101,100))
        _0x31 = false
        return
    end

    if _0x31 == false and db.actor:has_info(string.char(114,102,115,95,115,116,97,114,116,101,100)) then
        UnregisterScriptCallback(string.char(97,99,116,111,114,95,111,110,95,117,112,100,97,116,101), check_player_position_rfs)
        give_info(string.char(114,102,115,95,101,110,100,101,100))
